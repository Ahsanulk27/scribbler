<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Elsie:wght@400;900&display=swap" rel="stylesheet">
  <title>Explore Blogs</title>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <% if (currentUser) { %>
            <section class="my-blogs-section">
                <h2>My Blogs</h2>
                <div class="blog-cards">
                    <% if (userBlogs.length === 0) { %>
                        <p>You haven't written any blogs yet. <a href="/create">Create one!</a></p>
                    <% } else { %>
                        <% userBlogs.forEach(blog => { %>
                            <div class="blog-card">
                                <div class="card-content">
                                    <h3 class="card-title"><%= blog.title %></h3>
                                    <p class="card-date"><%= new Date(blog.date).toLocaleDateString() %></p>
                                    <p class="card-excerpt"><%= blog.content.substring(0, 100) %>...</p>
                                    <div class="card-actions">
                                        <a href="/blog/<%= blog.id %>" class="read-more">Read More</a>
                                        <form action="/delete-blog/<%= blog.id %>" method="POST" 
                                              onsubmit="return confirm('Are you sure you want to delete this blog?');">
                                            <button type="submit" class="delete-button">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </section>
        <% } %>

        <section class="other-blogs-section">
            <h2>Community Blogs</h2>
            <div class="blog-cards">
                <% if (otherBlogs.length === 0) { %>
                    <p>No community blogs available yet.</p>
                <% } else { %>
                    <% otherBlogs.forEach(blog => { %>
                        <div class="blog-card">
                            <div class="card-content">
                                <h3 class="card-title"><%= blog.title %></h3>
                                <p class="card-author">By <%= blog.author_name %></p>
                                <p class="card-date"><%= new Date(blog.date).toLocaleDateString() %></p>
                                <p class="card-excerpt"><%= blog.content.substring(0, 100) %>...</p>
                                <a href="/blog/<%= blog.id %>" class="read-more">Read More</a>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>
    </main>
    
    <%- include('partials/footer') %>
</body>
</html>